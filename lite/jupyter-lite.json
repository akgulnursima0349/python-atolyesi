{
  "jupyter-lite-schema-version": 0,
  "jupyter-config-data": {
    "appName": "Python Atölyesi Defterleri",
    "enableMemoryStorage": true,
    "contentsStorageDrivers": [
      "memoryStorageDriver"
    ],
    "workspacesStorageDrivers": [
      "memoryStorageDriver"
    ],
    "exposeAppInBrowser": true,
    "litePluginSettings": {
      "@jupyterlite/pyodide-kernel-extension:kernel": {
        "pyodideUrl": "../pyodide/pyodide.mjs",
        "disablePyPIFallback": true
      }
    },
    "settingsOverrides": {
      "@jupyterlab/translation-extension:plugin": {
        "locale": "tr_TR"
      },
      "@jupyterlab/notebook-extension:tracker": {
        "windowingMode": "none"
      }
    },
    "disabledExtensions": [
      "@jupyter-notebook/notebook-extension:trusted",
      "@jupyter-notebook/notebook-extension:checkpoints"
    ]
  }
}